# Copia este fichero como .env.local para configurar el entorno local.

# Si es "true", el Modo Testing arranca activado por defecto (ignora las
# fechas de desbloqueo de cada día). También se puede activar en caliente
# tocando 5 veces el título de la app. NUNCA lo pongas a "true" en el
# despliegue de producción que verá la persona sorprendida.
NEXT_PUBLIC_TESTING_MODE=false
